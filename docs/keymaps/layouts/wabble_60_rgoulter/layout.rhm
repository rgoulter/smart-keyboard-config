#lang rhombus
//// wabble-60 rgoulter: grid(5,12) + Nickel LegendIR from ortho-5x12.
//// Runs out-of-tree via viz-path; the bundle path matches the viz-path
//// default out/.cache/<dir>-bundle.json.

import:
  "../../src/keyboard_layout.rhm" open
  "../../src/svg.rhm" open
  "../../src/io.rhm" open

def bundle = "out/.cache/wabble_60_rgoulter-bundle.json"
def pts = grid(5, 12)
def layers = load_bundle_layers(bundle)
def dense = load_bundle_dense(bundle)
def names = [
  "Base (Dvorak)",
  "Gaming (QWERTY)",
  "Raise",
  "Lower",
  "Adjust"
]

ensure_dir("out")
emit_svg(
  "out/wabble-60-rgoulter-dense.svg",
  recipe_dense(
    "wabble-60 rgoulter",
    pts,
    dense
  )
)
emit_svg(
  "out/wabble-60-rgoulter-stacked.svg",
  recipe_stacked(
    "wabble-60 rgoulter",
    pts,
    layers,
    ~layer_names: names
  )
)
println("DONE wabble_60_rgoulter")
