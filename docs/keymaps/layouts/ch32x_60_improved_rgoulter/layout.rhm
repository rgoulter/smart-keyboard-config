#lang rhombus
//// ch32x-60-improved board: ansi_66 PointsIR + ansi-66-rgoulter LegendIR.
//// Runs out-of-tree via viz-path; the bundle path matches the viz-path
//// default out/.cache/<dir>-bundle.json.
//// Layers: 2 numbered bases (QWERTY, Dvorak) + 4 named layers.
//// named_layer_order = ["lower", "raise", "adjust"] then alphabetical rest (nav),
//// so engine order is lower, raise, adjust, nav.

import:
  "../../src/keyboard_layout.rhm" open
  "../../src/svg.rhm" open
  "../../src/io.rhm" open

def bundle = "out/.cache/ch32x_60_improved_rgoulter-bundle.json"
def pts = ansi_66()
def layers = load_bundle_layers(bundle)
def dense = load_bundle_dense(bundle)
def names = [
  "Base (QWERTY)",
  "Base (Dvorak)",
  "Lower",
  "Raise",
  "Adjust",
  "Nav"
]

ensure_dir("out")
emit_svg(
  "out/ch32x-60-improved-rgoulter-dense.svg",
  recipe_dense(
    "ch32x-60-improved rgoulter",
    pts,
    dense
  )
)
emit_svg(
  "out/ch32x-60-improved-rgoulter-stacked.svg",
  recipe_stacked(
    "ch32x-60-improved rgoulter",
    pts,
    layers,
    ~layer_names: names
  )
)
println("DONE ch32x_60_improved_rgoulter")
