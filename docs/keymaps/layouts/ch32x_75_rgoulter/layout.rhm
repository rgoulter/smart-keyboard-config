#lang rhombus
//// ch32x-75 rgoulter: grid(5,15) + Nickel LegendIR from ortho-5x15
//// (ortho-5x12 remapped with XXX padding for the 5x15 matrix).
//// Runs out-of-tree via viz-path; the bundle path matches the viz-path
//// default out/.cache/<dir>-bundle.json.

import:
  "../../src/keyboard_layout.rhm" open
  "../../src/svg.rhm" open
  "../../src/io.rhm" open

def bundle = "out/.cache/ch32x_75_rgoulter-bundle.json"
def pts = grid(5, 15)
def layers = load_bundle_layers(bundle)
def dense = load_bundle_dense(bundle)
def names = [
  "Base (Dvorak)",
  "Gaming (QWERTY)",
  "Raise",
  "Lower",
  "Adjust"
]

ensure_dir("out")
emit_svg(
  "out/ch32x-75-rgoulter-dense.svg",
  recipe_dense(
    "ch32x-75 rgoulter",
    pts,
    dense
  )
)
emit_svg(
  "out/ch32x-75-rgoulter-stacked.svg",
  recipe_stacked(
    "ch32x-75 rgoulter",
    pts,
    layers,
    ~layer_names: names
  )
)
println("DONE ch32x_75_rgoulter")
